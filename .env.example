# TubeArchivist Environment Variables
# Copy this file to .env and customize for your deployment

# ======================
# REQUIRED VARIABLES
# ======================

# TA_HOST: The URL that your BROWSER will use to access TubeArchivist
# This MUST be accessible from your browser, not just internal Docker network
# IMPORTANT: Must match exactly what you type in browser (including protocol and port)
#
# Examples:
#   - https://tubearchivist.yourdomain.com (recommended: domain with reverse proxy)
#   - http://31.97.134.168:8000 (public IP with port)
#   - http://yourdomain.com:8000 (domain with custom port)
#   - http://srv852129:8000 (only works if browser can resolve hostname via Tailscale/VPN)
#
# Best Practice: Use a domain with HTTPS via reverse proxy (Dokploy/Traefik/Nginx Proxy Manager)
# This provides SSL, no need to expose port 8000, and cleaner URLs
TA_HOST=https://tubearchivist.yourdomain.com

# TA_USERNAME: Initial admin username for first login
TA_USERNAME=admin

# TA_PASSWORD: Initial admin password for first login
# CHANGE THIS to something secure!
TA_PASSWORD=changeme123

# ELASTIC_PASSWORD: Password for Elasticsearch
# CHANGE THIS to something secure!
ELASTIC_PASSWORD=changeme123

# REDIS_CON: Redis connection string (internal Docker network)
REDIS_CON=redis://archivist-redis:6379

# TZ: Your timezone for scheduler
# Find your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ======================
# ELASTICSEARCH CONFIG
# ======================

# ES_URL: Elasticsearch connection URL (internal Docker network)
ES_URL=http://archivist-es:9200

# ES_JAVA_OPTS: Java heap size for Elasticsearch
# Recommended: 1g for small, 2g for medium, 4g+ for large installations
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ======================
# OPTIONAL VARIABLES
# ======================

# HOST_UID/HOST_GID: Set file ownership to match your host user
# Run 'id' command on your host to find your UID/GID
HOST_UID=1000
HOST_GID=1000

# TA_PORT: Override Nginx port (default: 8000)
# TA_PORT=8000

# TA_AUTO_UPDATE_YTDLP: Auto-update yt-dlp on container start
# TA_AUTO_UPDATE_YTDLP=true

# DJANGO_DEBUG: Enable debug mode (DO NOT use in production!)
# DJANGO_DEBUG=false
